@echo off
:: Зміна поточної робочої директорії на папку, де лежить цей батник
cd /d "%~dp0"

:: Перевіряємо, чи батник запущено у повноекранному режимі.
:: Якщо ні — запускаємо нове повноекранне вікно, а поточне миттєво закриваємо.
if "%~1" NEQ "fullscreen" (
    start wt -M cmd /c "%~f0" fullscreen
    exit /b
)

:: Тепер можна спокійно запускати venv та скрипт через відносні шляхи
call .venv\Scripts\activate
python -m src.main
